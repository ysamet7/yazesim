# Golden rules 1, 3 and 4: nothing from external/, no review report and no .env
# file ever enters git, not even with `git add -f` (scripts/src/lib/repo-guard.ts).
node scripts/src/repo-guard.ts --staged

pnpm exec lint-staged

# Golden rule 1: no secret reaches a commit.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks bulunamadı. Kurulum: brew install gitleaks (docs/runbooks/YEREL-GELISTIRME.md)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
