{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".nvmrc",
    "pnpm-workspace.yaml",
    "toolchain.json",
    "infra/docker/docker-compose.yml",
    ".github/workflows/ci.yml"
  ],
  "globalPassThroughEnv": ["CI", "GITHUB_ACTIONS", "DOCKER_HOST", "FORCE_COLOR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:db": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
