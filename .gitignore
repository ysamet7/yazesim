# Secrets: env files never enter git; only the documented template does.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.secrets/

# Old code dropped in for review only. It may contain secrets and is never
# committed, so it can never reach the public repository (README.md).
/external/

# Dependencies, build output, OS noise
node_modules/
dist/
.next/
.expo/
coverage/
*.log
.DS_Store

# Tooling caches and generated code
.turbo/
*.tsbuildinfo
next-env.d.ts
packages/database/src/generated/
playwright-report/
test-results/

# Foundry build output (forge-std is a git submodule under contracts/lib)
contracts/out/
contracts/cache/
contracts/broadcast/

# Local Claude Code settings (launch configs, permissions)
.claude/
