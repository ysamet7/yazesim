{
  "name": "@yazesim/test-support",
  "version": "0.0.0",
  "private": true,
  "description": "Test-only helpers shared by the API and the worker: a throwaway, migrated database and a fake chain RPC",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@yazesim/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@yazesim/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
