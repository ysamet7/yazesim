# Yerel Docker servisleri (infra/docker/docker-compose.yml).
# `pnpm bootstrap` bu şablondan infra/docker/.env dosyasını üretir: boş
# parolalar rastgele oluşturulur, dosyaya yazılır ve ekrana basılmaz.
# Üretilen .env dosyası asla commit'lenmez.

# PostgreSQL kullanıcı adı, parolası ve veritabanı adı.
POSTGRES_USER=yazesim
POSTGRES_PASSWORD=
POSTGRES_DB=yazesim
# Bilgisayarda dinlenen portlar; başka projelerin varsayılan portlarıyla çakışmaz.
POSTGRES_PORT=5433
# Redis parolası ve portu (kuyruklar, hız sınırı).
REDIS_PASSWORD=
REDIS_PORT=6380
# Yerel test zinciri (Anvil, zincir kimliği 31337) portu.
ANVIL_PORT=8546
