# YazeSim web uygulaması (apps/web). `pnpm bootstrap` bu şablondan
# apps/web/.env.local üretir. Buradaki her değer tarayıcıya gider: gizli bilgi
# asla yazılmaz (altın kural 2). Adı KEY, SECRET, TOKEN gibi görünen bir
# NEXT_PUBLIC_ değişkeni varsa derleme durur.
# Her değişkenin kuralı: packages/shared/src/env.ts (webEnvSchema).

# Ortam: local | staging | production
NEXT_PUBLIC_APP_ENV=local
# Sitenin adresi (mutlak bağlantılar ve sayfa bilgileri için).
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# API'nin adresi; sayfaların bağlanabildiği tek dış adres.
NEXT_PUBLIC_API_URL=http://localhost:4200
