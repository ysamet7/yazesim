# YazeSim API (apps/api). `pnpm bootstrap` bu şablondan apps/api/.env üretir:
# yerel adresler infra/docker/.env'den gelir, boş gizli değerler rastgele
# üretilir ve hiçbiri ekrana basılmaz. Üretilen .env asla commit'lenmez.
# Her değişkenin kuralı: packages/shared/src/env.ts (apiEnvSchema).

# Ortam: local | staging | production
APP_ENV=local
# Çalışma modu: development | test | production
NODE_ENV=development
# Log düzeyi: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# API'nin dinlediği port.
PORT=4200
# API'yi çerezle çağırabilecek web adresleri, virgülle ayrılmış.
CORS_ORIGINS=http://localhost:3200
# Önünde tek bir ters vekil sunucu varsa (staging, production) true.
TRUST_PROXY=false
# PostgreSQL ve Redis bağlantı adresleri (bootstrap doldurur).
DATABASE_URL=
REDIS_URL=
# Kuyruk anahtarlarının Redis'teki ön eki; API ve işçi aynı değeri kullanır.
QUEUE_PREFIX=yazesim
# Sohbet ve kişisel veri şifreleme anahtarları: <kimlik>:<32 baytlık base64url anahtar>,
# virgülle. Anahtar yenilenirken eskisi listede kalır; yeni kayıtlar etkin anahtarla yazılır.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY_ID=k1
# Anahtarlı özetlerin (e-posta, IP) gizli tuzu. Değişirse eski özetler eşleşmez.
HASH_PEPPER=
# Zincir kimliği: yerel 31337 (Anvil), staging 43113 (Fuji), canlı 43114 (Avalanche).
CHAIN_ID=31337
# Zincir düğümünün adresi (bootstrap yerel Anvil adresini yazar).
RPC_URL=
# Ana ağa (43114) bağlanmak için açık onay: yalnız canlıda ve onayla true (altın kural 5).
ALLOW_MAINNET=false
# NoR token adresi: yerelde test token'ı (bootstrap yazar), canlıda NoR'un kendi adresi. Faz 5.
NOR_TOKEN_ADDRESS=
# Yüklemelerin gönderildiği kasa adresi; sunucu yalnız izler, anahtarı tutmaz. Faz 5.
TREASURY_ADDRESS=
# Yönetim paneline girebilecek cüzdan adresleri, virgülle. Faz 2.
ADMIN_ADDRESSES=
# Yapay zekâ servisinin anahtarı. YALNIZ sunucuda durur (altın kural 2): kendi yerel
# .env dosyanıza girin; sohbete, koda veya dokümana yazmayın. Faz 4.
GEMINI_API_KEY=
