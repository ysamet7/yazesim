# YazeSim işçisi (apps/worker): kuyruk işleri ve zincir izleme. `pnpm bootstrap`
# bu şablondan apps/worker/.env üretir. Üretilen .env asla commit'lenmez.
# Her değişkenin kuralı: packages/shared/src/env.ts (workerEnvSchema).

# Ortam: local | staging | production
APP_ENV=local
# Çalışma modu: development | test | production
NODE_ENV=development
# Log düzeyi: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# İşçinin sağlık uç noktasının (/saglik) portu.
PORT=4210
# PostgreSQL ve Redis bağlantı adresleri (bootstrap doldurur).
DATABASE_URL=
REDIS_URL=
# Kuyruk anahtarlarının Redis'teki ön eki; API ile aynı olmalı.
QUEUE_PREFIX=yazesim
# Zincir kimliği: yerel 31337 (Anvil), staging 43113 (Fuji), canlı 43114 (Avalanche).
CHAIN_ID=31337
# Zincir düğümünün adresi (bootstrap yerel Anvil adresini yazar).
RPC_URL=
# Ana ağa (43114) bağlanmak için açık onay: yalnız canlıda ve onayla true (altın kural 5).
ALLOW_MAINNET=false
# NoR token adresi: yerelde test token'ı (bootstrap yazar), canlıda NoR'un kendi adresi. Faz 5.
NOR_TOKEN_ADDRESS=
# Yüklemelerin gönderildiği kasa adresi; işçi yalnız izler. Faz 5.
TREASURY_ADDRESS=
